FROM node:24-alpine AS build
WORKDIR /app
ARG VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
ARG VITE_MAP_TILE_ATTRIBUTION
ENV VITE_MAP_TILE_URL=$VITE_MAP_TILE_URL VITE_MAP_TILE_ATTRIBUTION=$VITE_MAP_TILE_ATTRIBUTION
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/hydrology/package.json packages/hydrology/package.json
RUN npm ci
COPY apps/web apps/web
COPY packages/hydrology packages/hydrology
RUN npm run build
FROM nginxinc/nginx-unprivileged:stable-alpine
COPY infra/nginx.conf /etc/nginx/nginx.conf
COPY --from=build /app/apps/web/dist /usr/share/nginx/html/chuvas_intensas
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s --retries=5 CMD wget -q -O /dev/null http://127.0.0.1:8080/chuvas_intensas/ || exit 1
